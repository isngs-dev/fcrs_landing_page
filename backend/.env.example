# FCRS backend environment variables.
# Copy this file to .env and fill in real values. NEVER commit .env.
# Every name below is documented with a PLACEHOLDER only — no real
# credentials, tokens, sheet IDs, or inbox addresses belong in this file.

# Shared OAuth2 credential (covers BOTH gmail.send and spreadsheets scopes).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token

# Google Sheets — the only data store.
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_RANGE=Leads!A:I

# Gmail — must be the account the OAuth credential belongs to.
GMAIL_SENDER_ADDRESS=sender@example.com

# FCRS team inbox that receives the full lead-detail notification.
INTERNAL_NOTIFICATION_EMAIL=leads@example.com

# Duplicate-submission identity-check window, in minutes.
DUPLICATE_WINDOW_MINUTES=30

# Local dev server port.
PORT=3000

# Browser origin allowed by CORS (the deployed frontend URL, or the local
# dev origin during development).
ALLOWED_ORIGIN=http://localhost:4321
