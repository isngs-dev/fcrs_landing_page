---
// Site-wide reviews experience, mounted once in BaseLayout so it appears on
// every page. Two pieces:
//   1. A small square floating button, fixed on screen at all times.
//   2. A full-viewport modal it opens — a customer-testimonials video.
// The modal auto-opens shortly after every load/reload so it's the first
// thing a visitor sees; closing it just dismisses that view — the next
// reload opens it again.
---

<button
  type="button"
  class="reviews-fab"
  id="reviews-fab"
  aria-haspopup="dialog"
  aria-controls="reviews-popup-modal"
  aria-label="Open customer reviews"
>
  <i class="fa-solid fa-star" aria-hidden="true"></i>
  <span>Reviews</span>
</button>

<div class="reviews-overlay" id="reviews-overlay" aria-hidden="true">
  <div
    class="reviews-modal"
    id="reviews-popup-modal"
    role="dialog"
    aria-modal="true"
    aria-label="Customer reviews"
  >
    <div class="modal-header">
      <div class="modal-title">
        <i class="fa-solid fa-star" aria-hidden="true"></i>
        <span class="modal-title-copy">
          <span class="modal-title-text">What Homeowners Say</span>
          <span class="modal-subtitle">Real Customer Reviews</span>
        </span>
      </div>
      <div class="modal-controls">
        <button
          type="button"
          class="modal-btn"
          id="reviews-popup-minimize"
          aria-label="Minimize reviews popup"
        >
          <i class="fa-solid fa-minus" aria-hidden="true"></i>
        </button>
        <button
          type="button"
          class="modal-btn"
          id="reviews-popup-close"
          aria-label="Close reviews popup"
        >
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>
    </div>

    <div class="badge-wrap">
      <div class="badge">
        <i class="fa-brands fa-google" aria-hidden="true"></i>
        <span class="badge-text">
          <span class="stars">★★★★★</span>
          <span class="rating-copy">Rated 4.9/5 across Alabama &amp; Georgia</span>
        </span>
      </div>
    </div>

    <div class="video-wrap">
      <video
        id="popup-video"
        class="testimonial-video"
        src="/videos/customer-testimonials.mp4"
        controls
        autoplay
        playsinline
        webkit-playsinline="true"
        muted
        preload="auto"
      ></video>
      <button
        type="button"
        class="video-play-fallback"
        id="popup-video-fallback"
        aria-label="Play video"
      >
        <i class="fa-solid fa-play" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</div>

<style>
  /* ---------- floating trigger ---------- */
  .reviews-fab {
    position: fixed;
    left: 22px;
    bottom: 22px;
    z-index: 9998;
    width: 76px;
    height: 76px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 14px 34px -12px rgba(15, 20, 25, 0.35);
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--ink);
    opacity: 1;
    transform: scale(1);
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms ease, box-shadow 220ms ease;
  }

  .reviews-fab i {
    color: var(--green);
    font-size: 18px;
  }

  .reviews-fab span {
    font-size: 11px;
  }

  .reviews-fab:hover {
    transform: scale(1.05) translateY(-2px);
    box-shadow: 0 18px 40px -12px rgba(15, 20, 25, 0.42);
  }

  .reviews-fab:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  .reviews-fab.is-hidden {
    opacity: 0;
    transform: scale(0.85);
    pointer-events: none;
  }

  /* ---------- overlay + modal ---------- */
  .reviews-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(13, 15, 18, 0.72);
    backdrop-filter: blur(6px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 320ms ease;
  }

  .reviews-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .reviews-modal {
    position: relative;
    width: min(820px, 100%);
    max-height: 90vh;
    overflow-y: auto;
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-2) 100%);
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 50px 100px -30px rgba(0, 0, 0, 0.7);
    padding: 26px 22px 30px;
    transform: scale(0.94) translateY(10px);
    opacity: 0;
    transition: transform 380ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 320ms ease;
  }

  .reviews-overlay.is-open .reviews-modal {
    transform: scale(1) translateY(0);
    opacity: 1;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }

  .modal-title {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .modal-title > i {
    color: var(--green);
    font-size: 20px;
  }

  .modal-title-copy {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .modal-title-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    color: #fff;
  }

  .modal-subtitle {
    font-size: 12.5px;
    color: var(--dark-panel-subtext);
  }

  .modal-controls {
    display: flex;
    gap: 8px;
    flex: 0 0 auto;
  }

  .modal-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    cursor: pointer;
    transition: background 180ms ease, transform 180ms ease;
  }

  .modal-btn:hover {
    background: var(--orange);
    transform: scale(1.06);
  }

  .modal-btn:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  /* ---------- google badge ---------- */
  .badge-wrap {
    text-align: center;
    margin-bottom: 22px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 12px 20px;
  }

  .badge > i {
    font-size: 24px;
    color: #fff;
  }

  .badge-text {
    text-align: left;
    line-height: 1.2;
  }

  .badge-text .stars {
    display: block;
    color: var(--gold);
    font-size: 15px;
    letter-spacing: 2px;
  }

  .rating-copy {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    color: #fff;
    margin-top: 2px;
  }

  /* ---------- testimonial video ---------- */
  .video-wrap {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 30px 60px -25px rgba(0, 0, 0, 0.65);
  }

  .testimonial-video {
    display: block;
    width: 100%;
    max-height: 68vh;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  /* Shown only if the browser blocks autoplay outright — a single tap here
     is a genuine user gesture, so play() is guaranteed to succeed. */
  .video-play-fallback {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    border: none;
    background: rgba(13, 15, 18, 0.65);
    color: #fff;
    font-size: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 4px;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .video-play-fallback.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .video-play-fallback:hover {
    transform: scale(1.06);
    background: var(--orange);
  }

  .video-play-fallback:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 3px;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 720px) {
    .reviews-modal {
      padding: 20px 14px 26px;
      border-radius: 22px;
    }

    .modal-title-text {
      font-size: 17px;
    }
  }

  @media (max-width: 640px) {
    .reviews-fab {
      width: 64px;
      height: 64px;
      left: 16px;
      bottom: 88px;
      border-radius: 18px;
    }
  }
</style>

<script>
  function initReviewsPopup() {
    const fab = document.getElementById("reviews-fab");
    const overlay = document.getElementById("reviews-overlay");
    const modal = document.getElementById("reviews-popup-modal");
    const closeBtn = document.getElementById("reviews-popup-close");
    const minimizeBtn = document.getElementById("reviews-popup-minimize");
    const video = document.getElementById(
      "popup-video"
    ) as HTMLVideoElement | null;
    const playFallback = document.getElementById("popup-video-fallback");
    if (!fab || !overlay || !modal) return;

    const AUTO_OPEN_DELAY = 400;

    let isOpen = false;
    let autoOpenTimer: number | null = null;

    function open() {
      isOpen = true;
      if (autoOpenTimer !== null) {
        window.clearTimeout(autoOpenTimer);
        autoOpenTimer = null;
      }
      overlay.classList.add("is-open");
      overlay.setAttribute("aria-hidden", "false");
      fab.classList.add("is-hidden");
      document.body.style.overflow = "hidden";
      hidePlayFallback();
      if (video) {
        // Belt-and-braces for autoplay policies across browsers: the
        // `muted`/`playsinline` attributes cover Chrome, Firefox, Edge, and
        // iOS/desktop Safari, but some in-app or older browsers still need
        // the JS property set explicitly right before play() is called.
        video.muted = true;
        video.playsInline = true;
        if (video.currentTime > 0 || video.ended) video.currentTime = 0;
        playVideoWhenReady();
      }
      window.setTimeout(() => closeBtn?.focus(), 380);
    }

    // Don't attempt play() until the browser actually has enough data
    // buffered — calling it too early on a slow connection can surface the
    // same rejection as a real autoplay block and mask the real cause.
    function playVideoWhenReady() {
      if (!video) return;
      if (video.readyState >= 3) {
        attemptPlay();
      } else {
        video.addEventListener("canplay", attemptPlay, { once: true });
      }
    }

    function attemptPlay() {
      if (!video) return;
      const playResult = video.play();
      if (playResult && typeof playResult.catch === "function") {
        playResult
          .then(() => {
            hidePlayFallback();
            unmuteNow();
          })
          .catch(() => {
            // Autoplay was blocked outright — show a tap-to-play control (a
            // click there is a genuine user gesture, so play() is
            // guaranteed to succeed), and also resume on the visitor's
            // very next interaction with the page in case they miss it.
            showPlayFallback();
            const resume = () => {
              video
                .play()
                .then(unmuteNow)
                .catch(() => {});
              document.removeEventListener("pointerdown", resume);
              document.removeEventListener("keydown", resume);
            };
            document.addEventListener("pointerdown", resume, { once: true });
            document.addEventListener("keydown", resume, { once: true });
          });
      }
    }

    // Browsers only block *starting* playback with sound without a user
    // gesture — once the video is already playing (muted), unmuting it via
    // script is not gesture-restricted. So the visitor hears audio
    // automatically, with no manual unmute needed.
    function unmuteNow() {
      if (video) video.muted = false;
    }

    function showPlayFallback() {
      playFallback?.classList.add("is-visible");
    }

    function hidePlayFallback() {
      playFallback?.classList.remove("is-visible");
    }

    playFallback?.addEventListener("click", () => {
      video
        ?.play()
        .then(unmuteNow)
        .catch(() => {});
      hidePlayFallback();
    });

    video?.addEventListener("play", hidePlayFallback);

    function close() {
      isOpen = false;
      overlay.classList.remove("is-open");
      overlay.setAttribute("aria-hidden", "true");
      fab.classList.remove("is-hidden");
      document.body.style.overflow = "";
      video?.pause();
      fab.focus();
    }

    fab.addEventListener("click", open);
    closeBtn?.addEventListener("click", close);
    minimizeBtn?.addEventListener("click", close);

    // Auto-close once the testimonial video finishes — no manual close needed.
    video?.addEventListener("ended", () => {
      if (isOpen) close();
    });

    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) close();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) close();
    });

    autoOpenTimer = window.setTimeout(open, AUTO_OPEN_DELAY);

    document.addEventListener("astro:before-swap", () => {
      if (autoOpenTimer !== null) window.clearTimeout(autoOpenTimer);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initReviewsPopup);
  } else {
    initReviewsPopup();
  }
</script>
