---
// Real customer reviews, driven by a small data structure so copy/images
// can be swapped without touching markup or JS.
//
// Image note: the four themed photos called for in this section's brief
// (consultation, crew-at-work, finished-roof, inspection) are not yet in
// public/images — they were shared as chat attachments, which this build
// step cannot write to disk. Until real photos land, each card reuses the
// closest-matching shot already in public/images so the section ships with
// a sensible visual today. Drop the real files in as:
//   public/images/reviews/alexis-lloyd.jpg   (consultation / insurance)
//   public/images/reviews/ben-williams.jpg   (crew at work)
//   public/images/reviews/damion-fondren.jpg (finished roof)
//   public/images/reviews/amy-jackson.jpg    (inspection)
// and update the `image` field below — nothing else needs to change.
const testimonials = [
  {
    name: "Alexis Lloyd",
    initials: "AL",
    image: "/images/service-commercial.jpg",
    category: "Customer Care & Insurance Support",
    icon: "fa-solid fa-handshake",
    accent: "var(--green)",
    rating: 5,
    highlight:
      "Having someone knowledgeable there to advocate and guide us made a huge difference.",
    review:
      "We recently had a wonderful experience with our roofing company, and I especially wanted to recognize Christopher Waldrop for being absolutely amazing throughout the entire process. He was knowledgeable, helpful, patient, and always willing to answer our questions without making us feel rushed or pressured. One thing we truly appreciated was how respectful the company was of our time and circumstances while we worked through decisions and waited for our HELOC process to be completed. Christopher was also incredibly helpful with the insurance side of everything. He was there for appointments, helped explain the process, and made dealing with insurance much less overwhelming. Having someone knowledgeable there to advocate and guide us made a huge difference. The crew was courteous, efficient, and did excellent work. Communication was clear throughout the project, and the entire experience felt professional and well organized from start to finish. We are very happy with the final result and would absolutely recommend them to anyone looking for a trustworthy roofing company!",
  },
  {
    name: "Ben Williams",
    initials: "BW",
    image: "/images/hero-bg.jpg",
    category: "Professional Roofing Team",
    icon: "fa-solid fa-helmet-safety",
    accent: "var(--orange)",
    rating: 5,
    highlight: "The hardest working roofers that I have met.",
    review:
      "Absolutely amazing company. Josh and his team are very knowledgeable, no pressure and the hardest working roofers that I have met to ensure that my family was taken care of from initial inspection to the completion of my roof replacement. This is the team to trust!",
  },
  {
    name: "Damion Fondren",
    initials: "DF",
    image: "/images/final-cta-bg.jpg",
    category: "Quality Workmanship",
    icon: "fa-solid fa-award",
    accent: "var(--gold)",
    rating: 5,
    highlight: "The roof looks great, and I feel confident it was done right.",
    review:
      "Josh is outstanding to work with. He was honest, responsive, and walked me through the entire process so there were no surprises. His crew worked efficiently and left everything clean when they were done. The roof looks great, and I feel confident knowing it was done right. If you want someone you can trust who delivers high-quality results, I can't recommend Josh enough.",
  },
  {
    name: "Amy Jackson",
    initials: "AJ",
    image: "/images/service-residential.jpg",
    category: "Insurance & Roof Replacement",
    icon: "fa-solid fa-file-shield",
    accent: "var(--green)",
    rating: 5,
    highlight: "Just like that, I was approved for a new roof.",
    review:
      "Great experience from start to finish. Jackson came and inspected my roof. He then called my insurance on my behalf and they sent someone out with whom he met. Just like that, I was approved for a new roof. This company's customer service and employees are knowledgeable and make getting a new roof — which was badly needed — simple. Highly recommend this company!",
  },
];
---

<section id="reviews" class="reviews">
  <div class="inner">
    <div data-reveal class="header">
      <span class="eyebrow">Real Customer Experiences</span>
      <h2>Trusted by Homeowners</h2>
      <p class="sub">
        From inspection to installation, our team is committed to making
        every roofing experience simple, professional, and stress-free.
      </p>
      <svg
        class="roofline"
        viewBox="0 0 600 40"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M0 38 L90 8 L180 38 L270 8 L360 38 L450 8 L540 38 L600 20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        ></path>
      </svg>
    </div>

    <div class="badge-wrap" data-reveal>
      <div class="badge">
        <i class="fa-brands fa-google"></i>
        <span class="badge-text">
          <span class="stars">★★★★★</span>
          <span class="rating-copy">Rated 4.9/5 across Alabama &amp; Georgia</span>
        </span>
      </div>
    </div>

    <div class="carousel" id="reviews-carousel" data-reveal>
      <button
        type="button"
        class="nav prev"
        id="reviews-prev"
        aria-label="Previous review"
      >
        <i class="fa-solid fa-chevron-left"></i>
      </button>

      <div class="viewport" id="reviews-viewport">
        <ul class="track" id="reviews-track">
          {
            testimonials.map((t, i) => (
              <li
                class="card"
                data-index={i}
                style={`--accent:${t.accent}`}
              >
                <div class="card-image">
                  <img src={t.image} alt="" loading="lazy" decoding="async" />
                  <span class="category-badge">
                    <i class={t.icon} />
                    {t.category}
                  </span>
                </div>
                <div class="card-body">
                  <div class="card-top">
                    <span class="avatar">{t.initials}</span>
                    <div class="who">
                      <span class="name">{t.name}</span>
                      <span class="stars" aria-label={`${t.rating} out of 5 stars`}>
                        {"★".repeat(t.rating)}
                      </span>
                    </div>
                    <i class="fa-solid fa-quote-right quote-glyph" />
                  </div>

                  <p class="highlight">&ldquo;{t.highlight}&rdquo;</p>

                  <blockquote class="review-text">{t.review}</blockquote>
                  <button type="button" class="read-more">
                    Read full review
                    <i class="fa-solid fa-chevron-down" />
                  </button>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <button
        type="button"
        class="nav next"
        id="reviews-next"
        aria-label="Next review"
      >
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </div>
</section>

<style>
  .reviews {
    background: linear-gradient(180deg, var(--navy) 0%, var(--navy-2) 100%);
    padding: var(--section-pad);
    position: relative;
    overflow: hidden;
  }

  .inner {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
  }

  /* ---------- header ---------- */
  .header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 40px;
    position: relative;
  }

  .eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 2.2px;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 12px;
  }

  .header h2 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--h2);
    color: #fff;
    margin-bottom: 14px;
  }

  .header .sub {
    color: var(--dark-panel-subtext);
    font-size: 16px;
    line-height: 1.6;
  }

  .roofline {
    width: 220px;
    height: 24px;
    color: rgba(255, 255, 255, 0.08);
    margin: 22px auto 0;
    display: block;
  }

  /* ---------- google badge ---------- */
  .badge-wrap {
    text-align: center;
    margin-bottom: 44px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 14px 22px;
  }

  .badge > i {
    font-size: 26px;
    color: #fff;
  }

  .badge-text {
    text-align: left;
    line-height: 1.2;
  }

  .badge-text .stars {
    display: block;
    color: var(--gold);
    font-size: 16px;
    letter-spacing: 2px;
  }

  .rating-copy {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    color: #fff;
    margin-top: 2px;
  }

  /* ---------- carousel shell ---------- */
  .carousel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .viewport {
    flex: 1;
    overflow: hidden;
    perspective: 1400px;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 8%,
      #000 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 8%,
      #000 92%,
      transparent 100%
    );
  }

  .track {
    display: flex;
    align-items: center;
    list-style: none;
    will-change: transform;
    transform-style: preserve-3d;
    cursor: grab;
    padding: 20px 0 30px;
  }

  .track.is-dragging {
    cursor: grabbing;
  }

  .nav {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .nav:hover {
    background: var(--orange);
    border-color: var(--orange);
    transform: scale(1.06);
  }

  /* ---------- card ---------- */
  .card {
    flex: 0 0 auto;
    width: min(380px, 82vw);
    margin: 0 14px;
    background: rgba(255, 255, 255, 0.045);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 30px 60px -25px rgba(0, 0, 0, 0.6);
    transition: box-shadow 0.35s ease, border-color 0.35s ease;
    transform: translateZ(0) scale(0.9) rotateY(0deg);
    opacity: 0.6;
  }

  .card.is-active {
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.75), 0 0 0 1px var(--accent);
  }

  .card-image {
    position: relative;
    height: 190px;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .card:hover .card-image img,
  .card.is-active .card-image img {
    transform: scale(1.045);
  }

  .card-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(13, 15, 18, 0) 40%, rgba(13, 15, 18, 0.85) 100%);
  }

  .category-badge {
    position: absolute;
    left: 16px;
    bottom: 14px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.3px;
    color: var(--navy);
    background: var(--accent);
    padding: 7px 13px;
    border-radius: 999px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .card.is-active .category-badge {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.1s;
  }

  .card-body {
    padding: 22px 24px 24px;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    position: relative;
  }

  .avatar {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
  }

  .who {
    display: flex;
    flex-direction: column;
    gap: 3px;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .card.is-active .who {
    opacity: 1;
    transform: translateX(0);
  }

  .name {
    font-family: var(--font-heading);
    font-weight: 700;
    color: #fff;
    font-size: 15px;
  }

  .card-top .stars {
    color: var(--gold);
    font-size: 12.5px;
    letter-spacing: 1.5px;
    transform: scale(1);
    transition: transform 0.3s ease;
  }

  .card.is-active .card-top .stars {
    animation: star-pop 0.5s ease;
  }

  @keyframes star-pop {
    0% {
      transform: scale(0.85);
    }
    55% {
      transform: scale(1.12);
    }
    100% {
      transform: scale(1);
    }
  }

  .quote-glyph {
    margin-left: auto;
    font-size: 22px;
    color: rgba(255, 255, 255, 0.14);
  }

  .highlight {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.5;
    color: var(--gold);
    margin-bottom: 12px;
  }

  .review-text {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--dark-panel-subtext);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card.is-expanded .review-text {
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .read-more {
    margin-top: 12px;
    background: none;
    border: none;
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.3px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    padding: 0;
  }

  .read-more i {
    font-size: 10px;
    transition: transform 0.3s ease;
  }

  .card.is-expanded .read-more i {
    transform: rotate(180deg);
  }

  .read-more:hover {
    color: var(--accent);
  }

  /* ---------- responsive ---------- */
  @media (max-width: 640px) {
    .nav {
      display: none;
    }

    .card {
      width: 84vw;
      margin: 0 8px;
    }

    .viewport {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-image img,
    .category-badge,
    .who,
    .card-top .stars {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  function initReviewsCarousel() {
    const root = document.getElementById("reviews-carousel");
    if (!root) return;

    const viewport = document.getElementById("reviews-viewport");
    const track = document.getElementById("reviews-track");
    const prevBtn = document.getElementById("reviews-prev");
    const nextBtn = document.getElementById("reviews-next");
    if (!viewport || !track || !prevBtn || !nextBtn) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const originalCards = Array.from(track.children);
    const setCount = 3; // enough copies either side to loop seamlessly
    for (let s = 1; s < setCount; s++) {
      originalCards.forEach((card) => {
        track.appendChild(card.cloneNode(true));
      });
    }
    const cards = Array.from(track.children);

    let cardWidth = 0;
    let setWidth = 0;
    let x = 0; // current translateX, always negative or zero
    const SPEED = 42; // px/sec, per spec (35-50px/sec)
    let lastTime = null;
    let paused = false;
    let dragging = false;
    let dragStartX = 0;
    let dragStartTx = 0;
    let rafId = null;

    function measure() {
      const first = cards[0];
      const style = first.getBoundingClientRect();
      const marginRight = parseFloat(getComputedStyle(first).marginRight);
      const marginLeft = parseFloat(getComputedStyle(first).marginLeft);
      cardWidth = style.width + marginLeft + marginRight;
      setWidth = cardWidth * originalCards.length;
      // start roughly in the middle copy so we can loop both directions
      x = -setWidth;
      track.style.transform = `translate3d(${x}px,0,0)`;
    }

    function applyDepth() {
      const viewportRect = viewport.getBoundingClientRect();
      const centerX = viewportRect.left + viewportRect.width / 2;
      let closestCard = null;
      let closestDist = Infinity;

      cards.forEach((card) => {
        const rect = card.getBoundingClientRect();
        const cardCenter = rect.left + rect.width / 2;
        const offset = cardCenter - centerX;
        const dist = Math.abs(offset);
        const norm = Math.min(dist / (viewportRect.width / 2), 1.4);

        const scale = Math.max(0.82, 1 - norm * 0.22);
        const opacity = Math.max(0.42, 1 - norm * 0.75);
        const rotateY = Math.max(-14, Math.min(14, (offset / viewportRect.width) * -28));
        const translateZ = -norm * 120;

        card.style.transform = reduceMotion
          ? "none"
          : `translateZ(${translateZ}px) scale(${scale}) rotateY(${rotateY}deg)`;
        card.style.opacity = String(opacity);

        if (dist < closestDist) {
          closestDist = dist;
          closestCard = card;
        }
      });

      cards.forEach((c) => c.classList.toggle("is-active", c === closestCard));
    }

    function wrap() {
      // Keep x within one set-width of the middle copy so cards never run out.
      if (x <= -setWidth * 2) {
        x += setWidth;
      } else if (x >= 0) {
        x -= setWidth;
      }
    }

    function tick(now) {
      if (lastTime === null) lastTime = now;
      const dt = (now - lastTime) / 1000;
      lastTime = now;

      if (!paused && !dragging && !reduceMotion) {
        x -= SPEED * dt;
        wrap();
        track.style.transform = `translate3d(${x}px,0,0)`;
      }

      applyDepth();
      rafId = requestAnimationFrame(tick);
    }

    function goToStep(dir) {
      x += dir * -cardWidth;
      wrap();
      track.style.transform = `translate3d(${x}px,0,0)`;
    }

    prevBtn.addEventListener("click", () => goToStep(-1));
    nextBtn.addEventListener("click", () => goToStep(1));

    root.addEventListener("mouseenter", () => (paused = true));
    root.addEventListener("mouseleave", () => (paused = false));
    root.addEventListener("focusin", () => (paused = true));
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget)) paused = false;
    });

    // drag / swipe
    function onPointerDown(e) {
      dragging = true;
      paused = true;
      track.classList.add("is-dragging");
      dragStartX = "touches" in e ? e.touches[0].clientX : e.clientX;
      dragStartTx = x;
    }

    function onPointerMove(e) {
      if (!dragging) return;
      const clientX = "touches" in e ? e.touches[0].clientX : e.clientX;
      const delta = clientX - dragStartX;
      x = dragStartTx + delta;
      wrap();
      track.style.transform = `translate3d(${x}px,0,0)`;
    }

    function onPointerUp() {
      if (!dragging) return;
      dragging = false;
      track.classList.remove("is-dragging");
      paused = false;
    }

    track.addEventListener("mousedown", onPointerDown);
    window.addEventListener("mousemove", onPointerMove);
    window.addEventListener("mouseup", onPointerUp);
    track.addEventListener("touchstart", onPointerDown, { passive: true });
    track.addEventListener("touchmove", onPointerMove, { passive: true });
    track.addEventListener("touchend", onPointerUp);

    // read-more toggles: mirror state across the cloned copies of the same
    // testimonial so the loop never shows a half-expanded duplicate.
    cards.forEach((card) => {
      const btn = card.querySelector(".read-more");
      const idx = card.getAttribute("data-index");
      btn?.addEventListener("click", () => {
        const expand = !card.classList.contains("is-expanded");
        cards.forEach((c) => {
          if (c.getAttribute("data-index") === idx) {
            c.classList.toggle("is-expanded", expand);
            const label = c.querySelector(".read-more");
            if (label) {
              label.innerHTML = expand
                ? 'Show less <i class="fa-solid fa-chevron-down"></i>'
                : 'Read full review <i class="fa-solid fa-chevron-down"></i>';
            }
          }
        });
        paused = expand;
      });
    });

    window.addEventListener("resize", measure);

    measure();
    applyDepth();
    rafId = requestAnimationFrame(tick);

    document.addEventListener("astro:before-swap", () => {
      if (rafId) cancelAnimationFrame(rafId);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initReviewsCarousel);
  } else {
    initReviewsCarousel();
  }
</script>
